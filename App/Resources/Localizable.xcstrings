    },
    "朝のくせを、振り返る": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LEARN YOUR MORNING PATTERNS"
          }
        }
      }
    },
    "あさやけ図鑑 Pro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawn Atlas Pro"
          }
        }
