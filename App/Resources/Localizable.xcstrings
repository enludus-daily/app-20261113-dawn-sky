    "いまは購入できません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases unavailable right now"
          }
        }
      }
    },
    "通信のよい場所で、この画面を開き直してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen this screen where you have a good connection."
          }
        }
